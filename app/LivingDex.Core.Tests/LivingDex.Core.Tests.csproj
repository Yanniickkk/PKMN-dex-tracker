<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LivingDex.Core\LivingDex.Core.csproj" />
  </ItemGroup>

  <!-- The pipeline's sample dataset, embedded the same way the real one is in the desktop
       project, so DatasetLoader can be tested against actual pipeline output rather than
       against a fixture written by hand to match it.
       Metadata references are qualified: a bare %(Filename) batches over every
       EmbeddedResource already in the project and gives a cross product. -->
  <Target Name="EmbedSampleDataset" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <_SampleTable Include="$(MSBuildThisFileDirectory)..\..\pipeline\tests\expected\sample-dataset\*.json" />
      <_SampleGame Include="$(MSBuildThisFileDirectory)..\..\pipeline\tests\expected\sample-dataset\games\*.json" />

      <EmbeddedResource Include="@(_SampleTable)">
        <LogicalName>dataset/%(_SampleTable.Filename)%(_SampleTable.Extension)</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="@(_SampleGame)">
        <LogicalName>dataset/games/%(_SampleGame.Filename)%(_SampleGame.Extension)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

</Project>