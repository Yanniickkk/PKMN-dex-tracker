@* The left-hand navigation. The collections in use, and the ones put away. *@
@using LivingDex.Core.UserData
@inject AppSettingsStore Settings
@inject IJSRuntime JS

<nav class="sidebar">
    <div class="sidebar-top">
        <a class="brand" href="">
            <span class="brand-mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M3 12h18" />
                    <circle cx="12" cy="12" r="3" fill="currentColor" stroke="none" />
                </svg>
            </span>
            <span class="brand-name">Living Dex Tracker</span>
        </a>

        <button type="button" class="icon-button" @onclick="ToggleTheme"
                title="@ToggleTitle" aria-label="@ToggleTitle">
            @if (_effective == "dark")
            {
                @* Currently dark, so the button offers light. *@
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <circle cx="12" cy="12" r="4" />
                    <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4" />
                </svg>
            }
            else
            {
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
                </svg>
            }
        </button>
    </div>

    <ul class="nav-list">
        <li>
            <NavLink class="nav-link" href="collections">
                <span class="nav-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="3" width="7" height="7" rx="1" />
                        <rect x="14" y="3" width="7" height="7" rx="1" />
                        <rect x="3" y="14" width="7" height="7" rx="1" />
                        <rect x="14" y="14" width="7" height="7" rx="1" />
                    </svg>
                </span>
                Collections
            </NavLink>
        </li>
        <li>
            <NavLink class="nav-link" href="archives">
                <span class="nav-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="4" width="18" height="4" rx="1" />
                        <path d="M5 8v11a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8" />
                        <path d="M10 12h4" />
                    </svg>
                </span>
                Archive
            </NavLink>
        </li>
    </ul>
</nav>

@code {
    private AppTheme _chosen = AppTheme.System;

    /// <summary>What is on screen, which is not the same as what was chosen while it is System.</summary>
    private string _effective = "light";

    private string ToggleTitle =>
        _effective == "dark" ? "Switch to light mode" : "Switch to dark mode";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _chosen = Settings.Load().Theme;
        await ApplyAsync(_chosen);
    }

    private async Task ToggleTheme()
    {
        // Toggling out of System lands on the opposite of what is actually on screen, rather
        // than on some remembered choice the player never made.
        _chosen = _effective == "dark" ? AppTheme.Light : AppTheme.Dark;

        Settings.Update(settings => settings with { Theme = _chosen });
        await ApplyAsync(_chosen);
    }

    private async Task ApplyAsync(AppTheme theme)
    {
        _effective = await JS.InvokeAsync<string>(
            "livingdex.applyTheme",
            theme.ToString().ToLowerInvariant());

        StateHasChanged();
    }
}
