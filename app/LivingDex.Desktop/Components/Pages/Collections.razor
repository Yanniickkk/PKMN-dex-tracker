@page "/collections"
@using LivingDex.Core.Dataset
@using LivingDex.Core.Reference
@using LivingDex.Core.UserData
@inject LoadedDataset Dataset
@inject UserDataStoreProvider StoreProvider
@inject IJSRuntime JS

<PageTitle>Collections</PageTitle>

<div class="page-header">
    <h1>Collections</h1>
    <a class="button button-primary" href="collections/new">New collection</a>
</div>

@if (_problem is not null)
{
    <DataFileNotice Problem="_problem" />
}
else if (_collections is null)
{
    <p class="muted">Reading your data file…</p>
}
else if (_collections.Count == 0)
{
    <div class="empty">
        <h2>@(_archived == 0 ? "No collections yet" : "Nothing here right now")</h2>
        <p>
            A collection is one living dex you are filling: a main game, the games you own that
            can feed it, and how finely it counts forms.
        </p>

        @if (_archived > 0)
        {
            <p class="muted">
                @Counted(_archived) in <a href="archives">the archive</a>, waiting to be restored
                or deleted.
            </p>
        }
        else
        {
            <p class="muted">
                Use <strong>New collection</strong> above to set one up.
            </p>
        }
    </div>
}
else
{
    @* Only offered once there is enough to look through. Two collections do not need finding. *@
    @if (_collections.Count > 2)
    {
        <div class="filters">
            <input type="search" class="filter-search" placeholder="Search by name" aria-label="Search by name"
                   value="@_search" @oninput="@(e => _search = e.Value?.ToString() ?? string.Empty)" />

            <label class="field-inline">
                <span>Main game</span>
                <select value="@_mainGame" @onchange="@(e => _mainGame = e.Value?.ToString() ?? string.Empty)">
                    <option value="">Any</option>
                    @foreach (var game in MainGamesInUse)
                    {
                        <option value="@game.Value">@GameName(game)</option>
                    }
                </select>
            </label>

            @if (IsFiltered)
            {
                <button type="button" class="button filter-clear" @onclick="ClearFilters">Clear</button>
            }
        </div>
    }

    @if (Shown.Count == 0)
    {
        <p class="muted filter-count" role="status">Nothing matches these filters.</p>
    }

    <ul class="card-list">
        @foreach (var stored in Shown)
        {
            var one = stored;

            <li class="card card-link">
                <h2><a href="collections/@one.Id.Value">@one.Name</a></h2>
                <dl>
                    <dt>Main game</dt>
                    <dd>@GameName(one.MainGame)</dd>

                    <dt>Linked games</dt>
                    <dd>@LinkedGamesOf(one)</dd>

                    <dt>Forms</dt>
                    <dd>@FormsOf(one)</dd>
                </dl>

                <div class="card-actions">
                    <a class="button" href="collections/@one.Id.Value/edit">Settings</a>
                    <button type="button" class="button" @onclick="() => AskToArchive(one)">Archive</button>
                </div>
            </li>
        }
    </ul>

    @if (_archived > 0)
    {
        <p class="muted archive-note">
            <a href="archives">@Counted(_archived) in the archive</a>
        </p>
    }
}

<dialog class="detail" @ref="_dialog" @onclose="@(() => _archiving = null)">
    @if (_archiving is { } collection)
    {
        <div class="detail-card detail-card-narrow">
            <header class="detail-header">
                <div class="detail-title">
                    <h2>Archive @collection.Name?</h2>
                </div>

                <button type="button" class="icon-button" @onclick="CloseDialog" aria-label="Close" title="Close">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                        <path d="M6 6l12 12M18 6L6 18" />
                    </svg>
                </button>
            </header>

            <section class="detail-section">
                <p>
                    It leaves this list and moves to the archive. Nothing is lost: everything you
                    have recorded stays with it, and you can restore it whenever you like.
                </p>
                <p class="muted">@Recorded(collection)</p>

                @if (_actionError is not null)
                {
                    <p class="notice notice-error" role="alert">@_actionError</p>
                }
            </section>

            <div class="actions">
                <button class="button" @onclick="CloseDialog" disabled="@_working">Cancel</button>
                <span class="actions-spacer"></span>
                <button class="button button-primary" @onclick="Archive" disabled="@_working">
                    @(_working ? "Archiving…" : "Archive it")
                </button>
            </div>
        </div>
    }
</dialog>

@code {
    private IReadOnlyList<DexCollection>? _collections;
    private UserDataDocument _document = UserDataDocument.Empty;
    private int _archived;
    private UserDataProblem? _problem;

    private string _search = string.Empty;
    private string _mainGame = string.Empty;

    private ElementReference _dialog;
    private DexCollection? _archiving;
    private string? _actionError;
    private bool _working;

    protected override async Task OnInitializedAsync() => await ReadAsync();

    private async Task ReadAsync()
    {
        var store = await StoreProvider.GetAsync();

        try
        {
            _document = (await store.LoadAsync()).Document;
            _collections = _document.InUse();
            _archived = _document.ArchivedCollections().Count;
            _problem = null;
        }
        catch (Exception exception) when (UserDataProblem.IsAboutTheFile(exception))
        {
            _problem = UserDataProblem.From(exception, store.BackupDirectory);
        }
    }

    /// <summary>The main games the player actually has a collection for, in dataset order.</summary>
    private IReadOnlyList<GameId> MainGamesInUse =>
        [.. Dataset.Reference.Games
            .Select(game => game.Id)
            .Where(id => _collections?.Any(one => one.MainGame == id) == true)];

    private bool IsFiltered => !string.IsNullOrWhiteSpace(_search) || _mainGame.Length > 0;

    private IReadOnlyList<DexCollection> Shown
    {
        get
        {
            if (_collections is null)
            {
                return [];
            }

            var needle = _search.Trim();

            return
            [
                .. _collections.Where(one =>
                    (needle.Length == 0 || one.Name.Contains(needle, StringComparison.OrdinalIgnoreCase))
                    && (_mainGame.Length == 0 || one.MainGame.Value == _mainGame)),
            ];
        }
    }

    private void ClearFilters()
    {
        _search = string.Empty;
        _mainGame = string.Empty;
    }

    private async Task AskToArchive(DexCollection collection)
    {
        _archiving = collection;
        _actionError = null;
        StateHasChanged();
        await JS.InvokeVoidAsync("livingdex.openDialog", _dialog);
    }

    private async Task CloseDialog() => await JS.InvokeVoidAsync("livingdex.closeDialog", _dialog);

    private async Task Archive()
    {
        if (_archiving is not { } collection)
        {
            return;
        }

        _working = true;
        _actionError = null;

        try
        {
            var store = await StoreProvider.GetAsync();
            var today = DateOnly.FromDateTime(DateTime.Now);

            var outcome = await store.UpdateAsync(document => document.CollectionWith(collection.Id) is null
                ? document
                : document.Archived(collection.Id, today));

            if (outcome == UpdateOutcome.Conflict)
            {
                _actionError =
                    "Something else changed your data file while this was being saved. "
                    + "Nothing was lost; try again.";
                return;
            }

            await ReadAsync();
            await CloseDialog();
        }
        catch (Exception exception) when (UserDataProblem.IsAboutTheFile(exception))
        {
            _actionError = UserDataProblem.From(exception).Sentence;
        }
        finally
        {
            _working = false;
            // Explicit rather than left to the render Blazor queues when an event handler
            // completes: this screen was seen once holding its disabled state over a file that
            // had already been written, and a screen stuck on "working" is worse than a wasted
            // render.
            StateHasChanged();
        }
    }

    private string Recorded(DexCollection collection)
    {
        var records = _document.RecordCountOf(collection.Id);
        return records == 1 ? "1 entry recorded" : $"{records} entries recorded";
    }

    private static string Counted(int collections) =>
        collections == 1 ? "1 collection" : $"{collections} collections";

    private string GameName(GameId game) => Dataset.Reference.FindGame(game)?.Title ?? game.Value;

    private string LinkedGamesOf(DexCollection collection) =>
        collection.LinkedGames.Count == 0
            ? "none"
            : string.Join(", ", collection.LinkedGames.Select(GameName));

    private static string FormsOf(DexCollection collection)
    {
        var kinds = new List<string>();

        if (collection.Forms.Regional)
        {
            kinds.Add("regional");
        }

        if (collection.Forms.Functional)
        {
            kinds.Add("functional");
        }

        if (collection.Forms.Cosmetic)
        {
            kinds.Add("cosmetic");
        }

        if (collection.Forms.GenderDifferences)
        {
            kinds.Add("gender differences");
        }

        return kinds.Count == 0 ? "base species only" : string.Join(", ", kinds);
    }
}
