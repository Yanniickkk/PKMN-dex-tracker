@page "/collections/{CollectionId}"
@using System.IO
@using LivingDex.Core.Dataset
@using LivingDex.Core.Dex
@using LivingDex.Core.Reference
@using LivingDex.Core.Transfers
@using LivingDex.Core.UserData
@inject LoadedDataset Dataset
@inject UserDataStoreProvider StoreProvider
@inject TransferGraph Transfers
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>@(_collection?.Name ?? "Collection")</PageTitle>

@if (_problem is not null)
{
    <h1>Collection</h1>
    <DataFileNotice Problem="_problem" />
}
else if (_error is not null)
{
    <h1>Collection</h1>
    <div class="notice notice-error" role="alert">
        <p>@_error</p>
    </div>
}
else if (_collection is null)
{
    <h1>Collection</h1>
    <p class="muted">Loading…</p>
}
else
{
    <div class="page-header">
        <h1>@_collection.Name</h1>

        <div class="header-actions">
            @* What it exports is what is on screen, which is why the label counts. A player who
               has filtered down to "still to catch in Emerald" wants that list and not the
               whole dex, and one who has filtered nothing gets the whole dex either way. *@
            <button type="button" class="button" @onclick="Export" disabled="@(_exporting || _shown.Count == 0)">
                @(_exporting ? "Exporting…" : ExportLabel)
            </button>
            <a class="button" href="collections">All collections</a>
        </div>
    </div>

    @if (_exported is not null)
    {
        <p class="muted export-done" role="status">Written to @_exported.</p>
    }

    @if (_exportError is not null)
    {
        <div class="notice notice-error" role="alert">
            <p>@_exportError</p>
        </div>
    }

    @* An archived collection is one that was put away, so it is read rather than filled in:
       every control that would write is off below. Saying so once, here, is what keeps that
       from reading as a bug. *@
    @if (ReadOnly)
    {
        <div class="notice notice-archived" role="status">
            <p>
                Archived@(_collection.ArchivedOn is { } day ? " on " + day.ToString("d MMMM yyyy", CultureInfo.InvariantCulture) : string.Empty).
                Nothing here can be changed until it is restored.
            </p>
            <p class="notice-detail"><a href="archives">Go to the archive</a></p>
        </div>
    }

    @* More than one list, one game. Diamond asks a player for 493 entries and shows a Sinnoh
       Pokedex of 151 with its own numbering; which of the two is on screen is the player's
       choice. Only offered when there is a choice to make.

       Two is the usual number and not the rule. X and Y show three Pokedexes of their own
       beside the National Dex, so the game's side of the switch is a list rather than a second
       option - and Sword and Legends: Z-A show several with no National Dex above them at all,
       which is the case this used to miss. *@
    @if (Dataset.Reference.DexChoiceCount(_collection.MainGame) > 1)
    {
        <div class="dex-switch">
            <label for="dex-view">Showing</label>
            <select id="dex-view" value="@ChosenView()" @onchange="OnViewChanged">
                @if (HasNationalDex())
                {
                    <option value="@NationalOption">National dex</option>
                }
                @foreach (var (value, label) in GameDexOptions())
                {
                    <option value="@value">@label</option>
                }
            </select>
        </div>
    }

    <div class="progress">
        <p class="progress-figures">
            @if (_progress.IsComplete)
            {
                <strong>All @_progress.Total in @GameName(_collection.MainGame)</strong>
            }
            else
            {
                <strong>@_progress.InMainGame of @_progress.Total</strong>
                <span>in @GameName(_collection.MainGame)</span>
                <span class="muted">@_progress.PercentComplete%</span>
            }

            @if (_progress.CaughtElsewhere > 0)
            {
                @* The secondary figure: caught, but the living dex is not done until it is home. *@
                <span class="progress-secondary">@_progress.CaughtElsewhere still to transfer</span>
            }
        </p>

        @* What the percentage cannot say: some of what is left is not a matter of playing
           longer. They stay in the total, because they are entries of this game's dex - a total
           that left out the awkward ones would be a different number wearing the dex's name. *@
        @if (_progress.Unreachable > 0)
        {
            <p class="progress-unreachable">@UnreachableSentence</p>
        }

        @* Decoration. Every figure it shows is in the sentence above it. *@
        <div class="progress-track" aria-hidden="true">
            <span class="progress-fill is-done" style="width: @BarWidth(_progress.InMainGame)"></span>
            <span class="progress-fill is-elsewhere" style="width: @BarWidth(_progress.CaughtElsewhere)"></span>
        </div>
    </div>

    <div class="filters">
        <input type="search" class="filter-search" placeholder="Search by name" aria-label="Search by name"
               value="@_search" @oninput="OnSearchInput" />

        <label class="toggle">
            <input type="checkbox" checked="@_filter.StillToCatch"
                   @onchange="@(e => Narrow(f => f with { StillToCatch = (bool)e.Value! }))" />
            Still to catch
        </label>

        <label class="toggle">
            <input type="checkbox" checked="@_filter.NotYetTransferred"
                   @onchange="@(e => Narrow(f => f with { NotYetTransferred = (bool)e.Value! }))" />
            Not yet transferred
        </label>

        @* One per game the collection covers, main game first. With no linked games this is the
           single switch it has always been; with some, it is how a player asks what Sapphire can
           still give them. Ticking several widens, the way the two status switches do. *@
        @foreach (var game in GamesOfCollection())
        {
            var which = game;

            <label class="toggle @(CanAskAvailability(which) ? "" : "is-disabled")"
                   title="@AvailabilityHint(which)">
                <input type="checkbox" disabled="@(!CanAskAvailability(which))"
                       checked="@_filter.AvailableIn.Contains(which)"
                       @onchange="@(e => ToggleAvailability(which, (bool)e.Value!))" />
                Available in @GameName(which)
            </label>
        }

        @* Narrows, where the two above widen: what is left to work through, minus what no
           amount of playing will produce. Only offered when there is something to hide. *@
        @if (_unreachable > 0)
        {
            <label class="toggle" title="@($"{_unreachable} of this dex cannot be got in your games")">
                <input type="checkbox" checked="@_filter.HideUnreachable"
                       @onchange="@(e => Narrow(f => f with { HideUnreachable = (bool)e.Value! }))" />
                Hide what I cannot get
            </label>
        }

        @if (!_filter.IsEmpty)
        {
            <button type="button" class="button filter-clear" @onclick="ClearFilters">Clear</button>
        }
    </div>

    @if (_lines.Count > 0 && !_filter.IsEmpty)
    {
        <p class="muted filter-count" role="status">
            @if (_shown.Count == 0)
            {
                <span>Nothing matches these filters.</span>
            }
            else
            {
                <span>Showing @_shown.Count of @_lines.Count.</span>
            }
        </p>
    }

    @if (_lines.Count == 0)
    {
        <div class="empty">
            <h2>Nothing to show</h2>
            <p>
                The dataset has no species for @_collection.MainGame yet, so there is no dex to
                build. Run the pipeline and rebuild the app.
            </p>
        </div>
    }
    else if (_shown.Count > 0)
    {
        @* One tab stop holding a cursor, rather than two thousand focusable buttons - and not
           only for the sake of the tab key: Virtualize renders the rows it is scrolling past, so
           the tile being moved towards does not exist yet and cannot be given focus. The grid
           keeps the focus, aria-activedescendant names the cell, and grid.js does the scrolling
           by row number rather than by element. *@
        <div class="dex-grid" @ref="_grid" tabindex="0" role="grid"
             aria-label="@(_collection.Name) dex" aria-activedescendant="@CursorId"
             style="--dex-columns: @_columns"
             @onkeydown="OnGridKey">
            @* Rows rather than tiles: Virtualize inserts spacer elements, which a CSS grid would
               lay out as if they were cells. A row is one grid of its own. *@
            <Virtualize Items="_rows" Context="row" ItemSize="RowHeight" OverscanCount="3">
                <div class="dex-row" role="row">
                    @for (var column = 0; column < row.Lines.Count; column++)
                    {
                        var index = row.Start + column;
                        var line = row.Lines[column];
                        var status = _captures.StatusOf(line.Target);
                        var label = StatusLabel(line, status);
                        var reachable = ReachableHere(line.Target);
                        var title = reachable
                            ? $"{line.Name} - {label}"
                            : $"{line.Name} - {label}; nothing in your games produces one";

                        <div class="tile @TileClass(status) @(reachable ? string.Empty : "is-unreachable") @(index == _cursor ? "is-cursor" : string.Empty)"
                             id="tile-@index" role="gridcell" title="@title">
                            <img class="tile-sprite @SpriteScaling" src="@SpriteFor(line)" alt="" loading="lazy" />
                            <span class="tile-number">#@line.Number.ToString("000", CultureInfo.InvariantCulture)</span>
                            <span class="tile-name">@line.Name</span>

                            @* Stretched over the whole tile, so the tile opens the detail while
                               the badge above it stays its own control. Two buttons, not one
                               inside another, which is not markup a browser will accept. *@
                            <button type="button" class="tile-open" tabindex="-1"
                                    @onclick="() => OpenFrom(index)">
                                <span class="visually-hidden">@line.Name, @label</span>
                            </button>

                            <button type="button" class="tile-badge @(status == CaptureStatus.NotCaught ? "is-empty" : "")"
                                    tabindex="-1" disabled="@ReadOnly" title="@ToggleHint(status)"
                                    @onclick="() => ToggleFrom(index)">
                                <span class="visually-hidden">@ToggleHint(status)</span>

                                @if (status == CaptureStatus.InMainGame)
                                {
                                    <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M20 6 9 17l-5-5" />
                                    </svg>
                                }
                                else if (status == CaptureStatus.CaughtElsewhere)
                                {
                                    @* An arrow, because what is left to do is move it. *@
                                    <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M4 12h13M12 5l7 7-7 7" />
                                    </svg>
                                }
                            </button>
                        </div>
                    }
                </div>
            </Virtualize>
        </div>
    }
}

@* Outside the grid on purpose: a modal belongs to the page, not to a row that scrolls. *@
<dialog class="detail" @ref="_dialog" @onclose="OnDialogClosed" @onclick="Close">
    @if (_trail is { } trail)
    {
        @* Clicks inside the card are not clicks on the backdrop. *@
        var selected = trail.Current;

        <div class="detail-card" @onclick:stopPropagation="true">
            @if (_trail is { CanGoBack: true })
            {
                @* Only while drilled in. One entry needs no trail to explain itself. *@
                <nav class="breadcrumb" aria-label="What this came from">
                    <button type="button" class="link-button" @onclick="Back">Back</button>

                    <ol>
                        @for (var step = 0; step < _trail.Steps.Count; step++)
                        {
                            var index = step;
                            var line = _trail.Steps[index];

                            <li>
                                @if (index == _trail.Steps.Count - 1)
                                {
                                    <span aria-current="page">@line.Name</span>
                                }
                                else
                                {
                                    <button type="button" class="link-button" @onclick="() => GoBackTo(index)">@line.Name</button>
                                }
                            </li>
                        }
                    </ol>
                </nav>
            }

            <header class="detail-header">
                <img class="detail-sprite @SpriteScaling" src="@SpriteFor(selected)" alt="" />

                <div class="detail-title">
                    <p class="detail-number">#@selected.Number.ToString("000", CultureInfo.InvariantCulture)</p>
                    <h2>@selected.Name</h2>
                    <p class="muted">@TypesOf(selected)</p>
                </div>

                <button type="button" class="icon-button" @onclick="Close" aria-label="Close" title="Close">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                        <path d="M6 6l12 12M18 6L6 18" />
                    </svg>
                </button>
            </header>

            @{
                var status = _captures.StatusOf(selected.Target);
                var held = _captures.RecordFor(selected.Target)?.HoldingGame;
            }

            <section class="detail-section">
                <h3>Where it is</h3>

                <div class="states" role="group" aria-label="Where it is">
                    <button type="button" class="state @(status == CaptureStatus.NotCaught ? "is-on" : "")"
                            disabled="@ReadOnly"
                            @onclick="() => SetStatus(selected, CaptureStatus.NotCaught)">
                        Not caught
                    </button>

                    <button type="button" class="state @(status == CaptureStatus.CaughtElsewhere ? "is-on" : "")"
                            disabled="@(ReadOnly || _collection!.LinkedGames.Count == 0)"
                            title="@(_collection!.LinkedGames.Count == 0 ? "This collection has no linked games." : null)"
                            @onclick="() => SetStatus(selected, CaptureStatus.CaughtElsewhere)">
                        Caught elsewhere
                    </button>

                    <button type="button" class="state @(status == CaptureStatus.InMainGame ? "is-on" : "")"
                            disabled="@ReadOnly"
                            @onclick="() => SetStatus(selected, CaptureStatus.InMainGame)">
                        In @GameName(_collection.MainGame)
                    </button>
                </div>

                @if (status == CaptureStatus.CaughtElsewhere)
                {
                    <label class="field-inline">
                        <span>Held in</span>
                        <select value="@(held?.Value)" disabled="@ReadOnly" @onchange="e => SetHoldingGame(selected, e)">
                            @foreach (var game in _collection.LinkedGames)
                            {
                                <option value="@game.Value" selected="@(held == game)">@GameName(game)</option>
                            }
                        </select>
                    </label>
                }

                @if (status != CaptureStatus.NotCaught)
                {
                    <label class="field-inline">
                        <span>Caught on</span>
                        <input type="date" disabled="@ReadOnly"
                               value="@(_captures.RecordFor(selected.Target)?.CaughtOn?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))"
                               @onchange="e => SetCaughtOn(selected, e)" />
                    </label>
                }

                <label class="field-inline field-note">
                    <span>Note</span>
                    @* Kept in hand while typing and written on blur: a save per keystroke would
                       rewrite the whole file thirty times for one sentence. *@
                    <textarea rows="2" readonly="@ReadOnly" value="@_note"
                              @oninput="e => _note = e.Value?.ToString() ?? string.Empty"
                              @onblur="() => SaveNote(selected)"></textarea>
                </label>

                @if (_saveError is not null)
                {
                    <p class="notice notice-error" role="alert">@_saveError</p>
                }
            </section>

            @{
                var sections = SectionsFor(selected);
                var unobtainable = UnobtainableHere(selected);
            }

            @if (unobtainable is { } reason)
            {
                @* Above the ways of getting it, because it explains why none of them is the
                   game the player is filling. *@
                <section class="detail-section">
                    <h3>Not in @GameName(_collection!.MainGame)</h3>
                    <p class="muted">@reason</p>
                </section>
            }

            @if (sections.Count == 0 && unobtainable is null)
            {
                <section class="detail-section">
                    <h3>How to get it</h3>
                    <p class="muted">@NothingToListMessage</p>
                </section>
            }
            else if (sections.Count > 0)
            {
                @foreach (var section in sections)
                {
                    <section class="detail-section">
                        <h3>@AcquisitionNames.Of(section.Kind)</h3>
                        <ul class="method-list">
                            @foreach (var method in section.Methods)
                            {
                                <li class="method">
                                    <div class="method-head">
                                        <MethodIcon Method="method" />

                                        @if (method is BreedingAcquisition breeding)
                                        {
                                            @* A line of its own rather than one button: every parent
                                               works, so every parent is somewhere to go. The words
                                               sit in their own elements because Blazor drops
                                               whitespace-only nodes between them. *@
                                            <span class="method-title method-parents">
                                                <span>Breed</span>

                                                @for (var index = 0; index < breeding.Parents.Count; index++)
                                                {
                                                    var parent = breeding.Parents[index];

                                                    @if (index > 0)
                                                    {
                                                        <span class="muted">or</span>
                                                    }

                                                    <button type="button" class="link-button"
                                                            title="Show @Dataset.Reference.NameOf(parent)"
                                                            @onclick="() => DrillTo(parent)">@Dataset.Reference.NameOf(parent)</button>
                                                }
                                            </span>
                                        }
                                        else if (PreviousStageOf(method) is { } previous)
                                        {
                                            <button type="button" class="link-button method-title"
                                                    title="Show @Dataset.Reference.NameOf(previous)"
                                                    @onclick="() => DrillTo(previous)">
                                                @Summary(method)
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="method-title">@Summary(method)</span>
                                        }

                                        <span class="method-game">@GameName(method.Game)</span>
                                    </div>

                                    @{
                                        var fields = FieldsOf(method);
                                    }

                                    @if (fields.Count > 0)
                                    {
                                        <dl class="method-fields">
                                            @foreach (var (label, value) in fields)
                                            {
                                                <dt>@label</dt>
                                                <dd>@value</dd>
                                            }
                                        </dl>
                                    }

                                    @if (method.Game != _collection!.MainGame)
                                    {
                                        @* Caught there, wanted here. The move is part of the answer. *@
                                        var route = RouteFor(method.Game, selected.Target);

                                        <div class="method-transfer">
                                            @if (route.Shortest is { } shortest)
                                            {
                                                <p>
                                                    <span class="muted">Then to @GameName(_collection!.MainGame):</span>
                                                    @TransferNames.Of(shortest)
                                                </p>

                                                @if (route.Alternatives.Any())
                                                {
                                                    <details>
                                                        <summary>@route.Alternatives.Count() other way@(route.Alternatives.Count() == 1 ? "" : "s")</summary>
                                                        <ul>
                                                            @foreach (var alternative in route.Alternatives)
                                                            {
                                                                <li>@TransferNames.Of(alternative)</li>
                                                            }
                                                        </ul>
                                                    </details>
                                                }
                                            }
                                            else
                                            {
                                                <p class="method-blocked">
                                                    Cannot be moved to @GameName(_collection!.MainGame).
                                                    <span class="muted">@route.Explanation</span>
                                                </p>
                                            }
                                        </div>
                                    }

                                    @* Where the claim came from, so a wrong encounter rate can be
                                       traced without rerunning the pipeline. *@
                                    <p class="method-source">
                                        @method.Source.Source, read @method.Source.RetrievedOn.ToString("d MMM yyyy", CultureInfo.InvariantCulture)
                                    </p>
                                </li>
                            }
                        </ul>
                    </section>
                }
            }
        </div>
    }
</dialog>

@code {
    /// <summary>
    /// How many tiles sit on one row, which is however many fit.
    /// </summary>
    /// <remarks>
    /// It used to be ten, fixed, and the worry written here was that virtualising needs a row
    /// height it can trust. It still does and it still has one: widening the grid changes how
    /// many tiles are on a row and not how tall the row is, so <see cref="RowHeight"/> holds
    /// whatever the window does. What a resize does invalidate is the chunking and the cursor's
    /// arithmetic, and both are redone in <see cref="ColumnsChanged"/>.
    ///
    /// Ten is the starting figure rather than the rule: it is what fits before the browser has
    /// been asked, and what is used if the ask fails.
    /// </remarks>
    private int _columns = 10;

    /// <summary>The narrowest a tile is allowed to be, in pixels, before a column is dropped.</summary>
    /// <remarks>
    /// Measured from what the grid was: ten columns in the old capped width came to 93 pixels
    /// each, and a 56 pixel sprite sits in that with room around it. So a window the old width
    /// still draws ten, and every pixel past it buys another tile rather than ten wider ones.
    /// </remarks>
    private const int TileMinWidth = 93;

    /// <summary>The gap between tiles and the grid's own padding. Must match <c>.dex-row</c>.</summary>
    private const int TileGap = 8;

    /// <summary>Must match the height a <c>.dex-row</c> actually takes, or scrolling drifts.</summary>
    private const float RowHeight = 116f;

    [Parameter]
    public string? CollectionId { get; set; }

    private DexCollection? _collection;
    private CaptureIndex _captures = CaptureIndex.Empty;
    private DexProgress _progress = DexProgress.Empty;
    private IReadOnlyList<DexLine> _lines = [];
    private IReadOnlyList<DexLine> _shown = [];
    //: Where the keyboard is in the grid: an index into _shown, not a focused element, because
    //: the element may not be rendered. -1 while there is nothing to point at.
    private int _cursor = -1;
    private ElementReference _grid;
    private bool _gridKeysHooked;
    //: Handed to the browser so the resize observer can call back. Disposed with the component.
    private DotNetObjectReference<CollectionGrid>? _self;
    //: How many of the whole dex nothing here can produce, caught or not. What decides whether
    //: the switch to hide them is worth offering.
    private int _unreachable;
    private DexFilter _filter = DexFilter.None;
    private string _search = string.Empty;
    //: What the switch calls the National Dex, and what it prefixes a game's own list with.
    //: A prefix rather than a bare name because a dex is named by the pipeline and "national"
    //: is a name somebody could give one; with the prefix, no name can be mistaken for it.
    private const string NationalOption = "national";
    private const string GameDexPrefix = "game:";

    //: Which of the game's lists is on screen. Not saved to the data file: it is a way of
    //: looking at a collection rather than part of what the collection is, the same as the
    //: filters beside it.
    private DexSource _view = DexSource.NationalDex;
    //: And which of the game's own Pokedexes, for a game that shows more than one. Null means
    //: the first one it lists, which is what a player is shown before they choose.
    private string? _dex;
    //: Answers "can this be got here", and remembers its answers. Rebuilt whenever the records
    //: change: transferring a Bulbasaur in is what makes Ivysaur available.
    private Availability _availability = new(ReferenceData.Empty, CaptureIndex.Empty);
    private DexTrail? _trail;
    private readonly Dictionary<(GameId From, DexTarget Target), TransferRouteResult> _routes = [];
    private string _note = string.Empty;
    private string? _saveError;
    private ElementReference _dialog;
    /// <summary>One row of the grid, and where in <c>_shown</c> it starts.</summary>
    /// <remarks>
    /// The start is carried rather than worked out, because a tile has to know its own index to
    /// be the cursor and Virtualize hands out an item without saying which one it is.
    /// </remarks>
    private sealed record GridRow(int Start, IReadOnlyList<DexLine> Lines);

    // An array, not IReadOnlyList: Virtualize takes an ICollection.
    private GridRow[] _rows = [];
    private string? _error;
    private UserDataProblem? _problem;
    private bool _exporting;
    private string? _exported;
    private string? _exportError;

    /// <summary>
    /// Whether this collection is read. An archived one is kept exactly as it was put away, so
    /// it is shown and not filled in.
    /// </summary>
    private bool ReadOnly => _collection?.IsArchived == true;

    protected override async Task OnParametersSetAsync()
    {
        _error = null;
        _problem = null;
        _collection = null;
        _captures = CaptureIndex.Empty;
        _progress = DexProgress.Empty;

        // The filter belongs to the dex on screen, not to the app. Walking into another
        // collection with the previous one's search still typed in reads as a bug.
        _filter = DexFilter.None;
        _search = string.Empty;
        _trail = null;
        _cursor = -1;
        _routes.Clear();

        var store = await StoreProvider.GetAsync();
        IReadOnlyList<CaptureRecord> records;

        try
        {
            var snapshot = await store.LoadAsync();
            _collection = snapshot.Document.Collections
                .FirstOrDefault(one => one.Id.Value == CollectionId);
            records = snapshot.Document.Records;
        }
        catch (Exception exception) when (UserDataProblem.IsAboutTheFile(exception))
        {
            _problem = UserDataProblem.From(exception, store.BackupDirectory);
            return;
        }

        if (_collection is null)
        {
            _error = "That collection is not in your data file. It may have been deleted.";
            return;
        }

        // Indexed once per visit: the grid asks for a status a thousand times while it scrolls.
        _captures = CaptureIndex.For(_collection.Id, records);
        _availability = new Availability(Dataset.Reference, _captures);

        // Whichever list the game itself names, which for every game so far is the National Dex.
        _view = Dataset.Reference.FindGame(_collection.MainGame)?.DexSource ?? DexSource.NationalDex;
        _dex = null;

        if (!Rebuild())
        {
            return;
        }

        ApplyFilter();
    }

    /// <summary>
    /// Builds the dex for the view on screen and recounts the progress. False when it could not
    /// be built, with the reason already in <c>_error</c>.
    /// </summary>
    /// <remarks>
    /// The captures are keyed by target rather than by number, so switching between the two
    /// lists keeps every tick. Only what is shown, and what the numbers beside it mean, change.
    /// </remarks>
    private bool Rebuild()
    {
        try
        {
            _lines = new DexBuilder(Dataset.Reference).Build(_collection!, _view, _dex);
        }
        catch (DexBuildException exception)
        {
            _error = exception.Message;
            return false;
        }

        _progress = DexProgress.Of(_lines, _captures, ReachableHere);
        return true;
    }

    /// <summary>True when the main game has both a National Dex and a Pokedex of its own.</summary>
    /// <summary>Whether the National Dex is one of the lists this game can show.</summary>
    private bool HasNationalDex() =>
        _collection is not null
        && Dataset.Reference.FindGame(_collection.MainGame) is { HasNationalDex: true };

    /// <summary>What to call the main game's own dex, for example <c>Sinnoh dex</c>.</summary>
    private string RegionalDexName() =>
        _collection is not null
        && Dataset.Reference.FindGame(_collection.MainGame) is { } game
        && !string.IsNullOrWhiteSpace(game.Region)
            ? $"{game.Region} dex"
            : "This game's dex";

    private static string GameDexOption(string? dex) => GameDexPrefix + dex;

    /// <summary>The value of the option in the switch that is currently on screen.</summary>
    private string ChosenView() =>
        _view == DexSource.NationalDex ? NationalOption : GameDexOption(_dex ?? FirstGameDex());

    /// <summary>
    /// The list the builder shows when the player has not chosen one, which is the first the
    /// game names - or nothing at all for a game whose single dex has no name.
    /// </summary>
    private string? FirstGameDex() =>
        _collection is not null
        && Dataset.Reference.DexNamesOf(_collection.MainGame) is { Count: > 0 } names
            ? names[0]
            : null;

    /// <summary>
    /// The game's own lists, as (option value, label) pairs: one per Pokédex it names, or a
    /// single nameless one for the twenty games that show one list and never had to call it
    /// anything.
    /// </summary>
    private IReadOnlyList<(string Value, string Label)> GameDexOptions()
    {
        if (_collection is null)
        {
            return [];
        }

        var named = Dataset.Reference.DexNamesOf(_collection.MainGame);

        return named.Count == 0
            ? [(GameDexOption(null), RegionalDexName())]
            : [.. named.Select(name => (GameDexOption(name), $"{name} dex"))];
    }

    private void OnViewChanged(ChangeEventArgs args)
    {
        var chosen = args.Value?.ToString() ?? NationalOption;

        var view = chosen == NationalOption ? DexSource.NationalDex : DexSource.GameDex;
        var dex = chosen.StartsWith(GameDexPrefix, StringComparison.Ordinal)
            ? chosen[GameDexPrefix.Length..]
            : null;

        if (view == _view && dex == _dex)
        {
            return;
        }

        _view = view;
        // Empty is how a nameless dex arrives back from the select, and null is what the builder
        // reads as "the list this game shows".
        _dex = string.IsNullOrEmpty(dex) ? null : dex;

        if (Rebuild())
        {
            ApplyFilter();
        }
    }

    /// <summary>
    /// The picture for one line: the form's own where the sheet has one, its species' where it
    /// does not.
    /// </summary>
    /// <remarks>
    /// Drawn in the main game's own style: an Emerald collection shows the 64x64 battle sprites
    /// an Emerald player saw, not today's artwork. The linked games do not get a say — the grid
    /// is one dex and one look, and the main game is whose dex it is.
    /// </remarks>
    private string SpriteFor(DexLine line) =>
        Dataset.SpritePath(line.Target, MainGameSpriteSet);

    /// <summary>
    /// The sprite set of the game this collection is built around, or null before one is loaded
    /// and for a game that has none of its own.
    /// </summary>
    private string? MainGameSpriteSet =>
        _collection is null ? null : Dataset.Reference.FindGame(_collection.MainGame)?.SpriteSet;

    /// <summary>
    /// How this game's pictures want to be scaled, as a class name.
    /// </summary>
    /// <remarks>
    /// Every generation up to the fifth drew its battle sprites by hand on a fixed grid — 64×64
    /// in Generation 3, 96×96 in Generation 5 — and those want nearest-neighbour scaling:
    /// smoothing turns a drawn Emerald sprite into a blur. Generation 6 has no sprites at all.
    /// X and Y are in 3D, what stands in for a sheet is a shot of each model, and the files are
    /// not even one size: 43×48 for a Bulbasaur, 121×129 for a Rayquaza. Scaling those with
    /// nearest-neighbour makes every edge ragged.
    ///
    /// The set used to name the generation, and one prefix could stand for every 3D one:
    /// <c>generation-vi</c> is a prefix of <c>generation-vii/</c> and <c>generation-viii/</c>
    /// and not of <c>generation-v/</c>. Brilliant Diamond and Shining Pearl ended that. They
    /// have no sheet of their own anywhere, so they draw from Pokémon HOME's renders and their
    /// set is called <c>home</c> — not a generation, because four games in two generations will
    /// share it.
    ///
    /// So the question is asked the other way round now: the five drawn generations are named
    /// and everything else is rendered. That is the safer default of the two — a new set nobody
    /// has told this about is far likelier to be a render than a hand-drawn grid, and it is
    /// what a game with no set of its own already fell back to.
    /// </remarks>
    private static readonly string[] DrawnByHand =
    [
        "generation-i/",
        "generation-ii/",
        "generation-iii/",
        "generation-iv/",
        "generation-v/",
    ];

    private string SpriteScaling =>
        MainGameSpriteSet is { } set
        && DrawnByHand.Any(one => set.StartsWith(one, StringComparison.Ordinal))
            ? "is-drawn"
            : string.Empty;

    /// <summary>
    /// Hooks the grid's own key handling once the element exists.
    /// </summary>
    /// <remarks>
    /// Not on the first render: the grid is only drawn once a dex has been built and something
    /// passes the filters, which is several renders later.
    ///
    /// The reference is checked rather than assumed, and this is the second time this component
    /// has been caught by it. A render where the grid is not drawn - "Loading…" while the data
    /// file is read, or a filter that matches nothing - leaves <c>_grid</c> holding nothing,
    /// and a count of what would be shown is not the same question as whether it has been
    /// drawn. Hooking is therefore attempted until it reports that it worked.
    /// </remarks>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // An element reference is only good once the element has actually been drawn, and the
        // grid is not drawn at all while nothing passes the filters.
        if (_shown.Count == 0 || string.IsNullOrEmpty(_grid.Id))
        {
            return;
        }

        if (!_gridKeysHooked)
        {
            _gridKeysHooked = await JS.InvokeAsync<bool>("livingdex.gridKeys", _grid);
        }

        // Nothing comes back the second time the same element is offered, which is what makes
        // this safe to run on every render: a grid that is already watched answers zero.
        _self ??= DotNetObjectReference.Create(this);

        var columns = await JS.InvokeAsync<int>(
            "livingdex.watchColumns", _grid, TileMinWidth, TileGap, TileGap, _self);

        if (columns > 0)
        {
            ColumnsChanged(columns);
        }
    }

    /// <summary>
    /// The grid is a different width, so it holds a different number of tiles.
    /// </summary>
    /// <remarks>
    /// Called from the browser, by the observer <c>grid.js</c> puts on the grid element, and
    /// once from the first render with whatever fits right now. Public and <c>JSInvokable</c>
    /// because that is what calling into a component from JavaScript asks for.
    ///
    /// The cursor is an index into <c>_shown</c> rather than a row and a column, which is what
    /// makes this cheap: reflowing moves the tile a player was on to a different place on the
    /// screen and does not move it in the list, so there is nothing to recompute but the rows.
    /// </remarks>
    [JSInvokable]
    public void ColumnsChanged(int columns)
    {
        var wanted = Math.Max(1, columns);

        if (wanted == _columns)
        {
            return;
        }

        _columns = wanted;
        Chunk();
        StateHasChanged();
    }

    /// <summary>Cuts what is on screen into rows of the width the grid currently has.</summary>
    private void Chunk() =>
        _rows = [.. _shown.Chunk(_columns).Select((lines, row) => new GridRow(row * _columns, lines))];

    /// <summary>
    /// Lets go of the reference the browser was given.
    /// </summary>
    /// <remarks>
    /// The observer itself needs nothing: <c>grid.js</c> hangs it on the grid element, so it is
    /// collected with the element when the page goes. This is the .NET half, which is not.
    /// </remarks>
    public void Dispose() => _self?.Dispose();

    /// <summary>What the export button says, which is also what it will write.</summary>
    private string ExportLabel =>
        _filter.IsEmpty ? "Export" : $"Export these {_shown.Count}";

    /// <summary>
    /// Writes what is on screen as a spreadsheet.
    /// </summary>
    /// <remarks>
    /// The dex on screen, in the order it is drawn, with the filters applied: "export what I am
    /// looking at" is the only rule that does not need explaining, and the button says how many
    /// rows that is whenever it is not simply all of them.
    /// </remarks>
    private async Task Export()
    {
        if (_collection is null || _shown.Count == 0)
        {
            return;
        }

        _exporting = true;
        _exported = null;
        _exportError = null;

        try
        {
            var csv = CollectionCsv.Of(
                _shown,
                _captures,
                GameName(_collection.MainGame),
                GameName,
                ReachableHere);

            var name = CollectionCsv.FileNameFor(_collection.Name, DateOnly.FromDateTime(DateTime.Now));

            // Back to the UI thread's dialog and away from it again: the page only learns where
            // the file went, or that the player changed their mind.
            _exported = WpfExportPrompt.SaveCsv(name, csv);
        }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException)
        {
            _exportError = $"That file could not be written. {exception.Message}";
        }
        finally
        {
            _exporting = false;
        }

        await Task.CompletedTask;
    }

    /// <summary>The cell the keyboard is on, for <c>aria-activedescendant</c>.</summary>
    private string? CursorId => _cursor < 0 ? null : $"tile-{_cursor}";

    /// <summary>
    /// The keyboard's way round the grid: the arrows, the ends, a page at a time, Enter to read
    /// and Space to tick.
    /// </summary>
    /// <remarks>
    /// The browser's own scrolling on these keys is stopped in grid.js rather than here.
    /// Blazor's <c>preventDefault</c> is fixed when the element is rendered, so it cannot be
    /// decided per key - and blanket-stopping it would swallow Tab, which is the one key a
    /// keyboard user must always have.
    /// </remarks>
    private async Task OnGridKey(KeyboardEventArgs e)
    {
        if (_shown.Count == 0)
        {
            return;
        }

        // A first key press with no cursor lands on the first tile rather than moving from
        // nowhere, so arriving by Tab and pressing an arrow does something visible.
        if (_cursor < 0)
        {
            await MoveCursorTo(0);
            return;
        }

        switch (e.Key)
        {
            case "ArrowRight":
                await MoveCursorTo(_cursor + 1);
                break;

            case "ArrowLeft":
                await MoveCursorTo(_cursor - 1);
                break;

            case "ArrowDown":
                await MoveCursorTo(_cursor + _columns);
                break;

            case "ArrowUp":
                await MoveCursorTo(_cursor - _columns);
                break;

            case "Home":
                await MoveCursorTo(e.CtrlKey ? 0 : _cursor - (_cursor % _columns));
                break;

            case "End":
                await MoveCursorTo(e.CtrlKey ? _shown.Count - 1 : _cursor - (_cursor % _columns) + _columns - 1);
                break;

            case "PageDown":
                await MoveCursorTo(_cursor + (_columns * await RowsVisible()));
                break;

            case "PageUp":
                await MoveCursorTo(_cursor - (_columns * await RowsVisible()));
                break;

            case "Enter":
                await Open(_shown[_cursor]);
                break;

            case " ":
            case "Spacebar":
                await QuickToggle(_shown[_cursor]);
                // The tile that was just ticked is redrawn, so if the focus was still on its
                // button - which a click leaves it on - it has just gone.
                await FocusGrid();
                break;

            default:
                break;
        }
    }

    /// <summary>
    /// Moves the cursor, clamped to the ends, and scrolls its row into view.
    /// </summary>
    /// <remarks>
    /// Clamped rather than wrapped. Wrapping right off the end of a row onto the start of the
    /// next is what a list does; this is a grid, and a player counting columns to find Pikachu
    /// would have the count shift under them.
    /// </remarks>
    private async Task MoveCursorTo(int index)
    {
        var next = Math.Clamp(index, 0, _shown.Count - 1);

        if (next == _cursor)
        {
            return;
        }

        _cursor = next;
        await JS.InvokeVoidAsync("livingdex.showRow", _grid, _cursor / _columns, RowHeight);
    }

    /// <summary>How many rows a page holds, asked rather than assumed: the window can be any height.</summary>
    private async Task<int> RowsVisible() =>
        await JS.InvokeAsync<int>("livingdex.rowsVisible", _grid, RowHeight);

    /// <summary>
    /// Clicking a tile puts the cursor on it, so the keyboard carries on from where the mouse
    /// left off.
    /// </summary>
    /// <remarks>
    /// The focus is handed to the grid before anything else happens, and that is not a detail:
    /// the click leaves it on the tile's own button, and the first tick redraws that tile and
    /// takes the button - and the focus, and every key after it - with it. It also means the
    /// modal gives the focus back to the grid rather than to a button that may no longer exist.
    /// </remarks>
    private async Task OpenFrom(int index)
    {
        _cursor = index;
        await FocusGrid();
        await Open(_shown[index]);
    }

    private async Task ToggleFrom(int index)
    {
        _cursor = index;
        await FocusGrid();
        await QuickToggle(_shown[index]);
    }

    private async Task FocusGrid()
    {
        if (!string.IsNullOrEmpty(_grid.Id))
        {
            await JS.InvokeVoidAsync("livingdex.focusGrid", _grid);
        }
    }

    /// <summary>
    /// Opens the detail for one entry, caught or not. An entry you have not found yet is
    /// exactly the one you need to read about, so nothing here depends on its status.
    /// </summary>
    private async Task Open(DexLine line)
    {
        _trail = DexTrail.StartingAt(line);
        _saveError = null;
        _note = _captures.RecordFor(line.Target)?.Note ?? string.Empty;

        // Rendered before it is opened, or the first frame of the dialog is empty.
        StateHasChanged();
        await JS.InvokeVoidAsync("livingdex.openDialog", _dialog);
    }

    /// <summary>
    /// What an evolution comes from, when the popup can show it.
    /// </summary>
    /// <remarks>
    /// One target, because an evolution has one earlier stage. Breeding leads somewhere too, but
    /// to any of several parents, so its links are built where they are drawn. A wild slot or a
    /// gift is the end of the line.
    /// </remarks>
    private DexTarget? PreviousStageOf(AcquisitionMethod method) =>
        method is EvolutionAcquisition evolution
        && Dataset.Reference.FindEvolutionRule(evolution.Rule) is { } rule
            ? rule.From
            : null;

    private async Task DrillTo(DexTarget target)
    {
        // The note belongs to the entry that was on screen, so it is written before moving on.
        await FlushNote();
        _trail?.GoTo(LineFor(target));
        LoadNote();
    }

    private async Task Back()
    {
        await FlushNote();
        _trail?.Back();
        LoadNote();
    }

    private async Task GoBackTo(int step)
    {
        await FlushNote();
        _trail?.TruncateTo(step);
        LoadNote();
    }

    private void LoadNote() =>
        _note = _trail is null ? string.Empty : _captures.RecordFor(_trail.Current.Target)?.Note ?? string.Empty;

    /// <summary>
    /// The dex line for an entry, made up when the dex has none. A previous stage can be outside
    /// this collection - a baby Pokemon the main game's dex does not list, or a form the player
    /// has switched off - and refusing to show it would break the chain exactly where it is most
    /// worth reading.
    /// </summary>
    private DexLine LineFor(DexTarget target) =>
        _lines.FirstOrDefault(line => line.Target == target)
        ?? DexLines.For(Dataset.Reference, target);

    private async Task Close() => await JS.InvokeVoidAsync("livingdex.closeDialog", _dialog);

    /// <summary>
    /// Runs however the dialog was closed, including Escape and the backdrop, so the selection
    /// cannot survive the thing that showed it.
    /// </summary>
    private async Task OnDialogClosed()
    {
        // Runs for Escape and the backdrop too, so a note typed and not blurred is still saved.
        await FlushNote();
        _trail = null;
    }

    /// <summary>Writes the note if it differs from what is stored.</summary>
    private async Task FlushNote()
    {
        if (_trail is not { } trail)
        {
            return;
        }

        var line = trail.Current;
        var stored = _captures.RecordFor(line.Target)?.Note ?? string.Empty;
        if (_note == stored)
        {
            return;
        }

        await SaveNote(line);
    }

    private async Task SaveNote(DexLine line)
    {
        var note = string.IsNullOrWhiteSpace(_note) ? null : _note.Trim();
        await Write(Current(line) with { Note = note });
    }

    /// <summary>
    /// Moves an entry between the three states. What that does to the holding game and the catch
    /// date is <see cref="CaptureEditing.WithStatus"/>'s business; today's date comes from here
    /// because only the app knows what day it is.
    /// </summary>
    private async Task SetStatus(DexLine line, CaptureStatus status)
    {
        var current = Current(line);
        if (current.Status == status)
        {
            return;
        }

        await Write(current.WithStatus(
            status,
            _collection!.MainGame,
            _collection.LinkedGames.Count > 0 ? _collection.LinkedGames[0] : null,
            DateOnly.FromDateTime(DateTime.Now)));
    }

    private async Task SetHoldingGame(DexLine line, ChangeEventArgs e)
    {
        if (e.Value?.ToString() is not { Length: > 0 } chosen)
        {
            return;
        }

        var game = new GameId(chosen);
        await Write(Current(line) with
        {
            Status = game == _collection!.MainGame ? CaptureStatus.InMainGame : CaptureStatus.CaughtElsewhere,
            HoldingGame = game,
        });
    }

    private async Task SetCaughtOn(DexLine line, ChangeEventArgs e)
    {
        var text = e.Value?.ToString();
        DateOnly? caughtOn = DateOnly.TryParse(text, CultureInfo.InvariantCulture, out var parsed)
            ? parsed
            : null;

        await Write(Current(line) with { CaughtOn = caughtOn });
    }

    /// <summary>What is stored for an entry, or an empty record to build on.</summary>
    private CaptureRecord Current(DexLine line) =>
        _captures.RecordFor(line.Target) ?? CaptureRecord.NotCaught(_collection!.Id, line.Target);

    /// <summary>
    /// Writes one record to the data file and brings the screen back in step with it.
    /// </summary>
    /// <remarks>
    /// Retried against whatever is on disk, the same as every other write: a record replaces
    /// only its own entry, so a file that moved on in the meantime can be written to again
    /// without losing what changed.
    /// </remarks>
    private async Task Write(CaptureRecord record)
    {
        // Every control that could reach here is disabled while the collection is archived. This
        // is the same rule said where the writing happens, so a keyboard, a stale render or a
        // later control cannot get round it.
        if (ReadOnly)
        {
            return;
        }

        _saveError = null;
        var store = await StoreProvider.GetAsync();
        UserDataDocument? written = null;
        UpdateOutcome outcome;

        try
        {
            outcome = await store.UpdateAsync(document => written = document.WithRecord(record));
        }
        catch (Exception exception) when (UserDataProblem.IsAboutTheFile(exception))
        {
            _saveError = UserDataProblem.From(exception).Sentence;
            return;
        }

        if (outcome == UpdateOutcome.Conflict || written is null)
        {
            _saveError = "Something else changed your data file while this was being saved. Nothing was lost; try again.";
            return;
        }

        // Everything the screen shows about records is rebuilt from what was written, rather
        // than patched in two places and left to drift.
        _captures = CaptureIndex.For(_collection!.Id, written.Records);
        // A transfer can make an evolution reachable that was not a moment ago, so the
        // answers this remembers are no longer good.
        _availability = new Availability(Dataset.Reference, _captures);
        _progress = DexProgress.Of(_lines, _captures, ReachableHere);
        ApplyFilter();
        LoadNote();
    }

    /// <summary>The types shown under the name. Which types those are is a dataset question.</summary>
    private string TypesOf(DexLine line)
    {
        var types = Dataset.Reference.TypesOf(line.Target);
        return types.Count == 0 ? "Unknown typing" : string.Join(" / ", types);
    }

    /// <summary>
    /// Every way to get one entry in the games this collection covers, grouped into the popup's
    /// sections. The linked games are included: "how do I get this" is answered by the whole
    /// collection, not by the main game alone. The same list orders the methods inside a
    /// section, so the main game is always read first.
    /// </summary>
    private IReadOnlyList<AcquisitionSection> SectionsFor(DexLine line)
    {
        var games = GamesOfCollection();

        return AcquisitionSections.Of(
            games.SelectMany(game => Dataset.Reference.MethodsFor(game, line.Target)),
            games);
    }

    /// <summary>The main game first, then the linked ones in the order the player linked them.</summary>
    private IReadOnlyList<GameId> GamesOfCollection() =>
        _collection is null ? [] : [_collection.MainGame, .. _collection.LinkedGames];

    /// <summary>
    /// Why the main game's dex says this entry cannot be filled there, when it says so.
    /// </summary>
    /// <remarks>
    /// The pipeline has recorded these since Phase 0.7 and no screen ever read one, so a player
    /// looking at Zangoose in an Emerald collection saw "no recorded way to get this" - which is
    /// true of Emerald and unhelpful, because the dataset knows it is a Ruby Pokemon and says so.
    /// Shown even when there are ways listed: those ways are all in other games, and this is the
    /// sentence that explains why.
    /// </remarks>
    private string? UnobtainableHere(DexLine line) =>
        _collection is null
            ? null
            : Dataset.Reference.FindDexEntry(_collection.MainGame, line.Target)?.UnobtainableReason;

    /// <summary>
    /// Why a section list is empty. "We have no data" and "there is no way to get this" are
    /// different answers and the player has to be able to tell them apart.
    /// </summary>
    private string NothingToListMessage => GamesOfCollection().Any(Dataset.Reference.HasAcquisitionData)
        ? "No recorded way to get this in your games."
        : $"The dataset has no encounter data for {GameName(_collection!.MainGame)} yet, so there is nothing to list here.";

    /// <summary>
    /// The line that tells two methods in the same section apart at a glance.
    /// </summary>
    /// <remarks>
    /// Breeding is not here. Its line names several parents and each of them is a link, so it is
    /// built in the markup instead of as one string that would have to be taken apart again.
    /// </remarks>
    private string Summary(AcquisitionMethod method) => method switch
    {
        GiftAcquisition gift => AcquisitionNames.Of(gift.GiftKind),

        WildAcquisition wild =>
            $"{wild.Location}{(wild.SubArea is null ? "" : $", {wild.SubArea}")}",

        EvolutionAcquisition evolution => Dataset.Reference.FindEvolutionRule(evolution.Rule) is { } rule
            ? $"From {Dataset.Reference.NameOf(rule.From)}"
            : "From an earlier stage",

        TradeAcquisition trade => trade.Wants is { } wanted
            ? $"Trade a {Dataset.Reference.NameOf(wanted)}"
            : "Trade anything for it",

        // The one line that names the Pokemon rather than the way, because the way is the whole
        // of the record below it and what a player needs first is "catch one of these". A change
        // that produces the species itself is the exception - Black 2's Reveal Glass turning a
        // Therian Forme back - and naming the species there would read as "From Tornadus" on
        // Tornadus's own tile.
        FormChangeAcquisition change => change.Target.Form is null
            ? "From another of its formes"
            : $"From {Dataset.Reference.NameOf(DexTarget.ForSpecies(change.Target.Species))}",

        // The place, not the deed: "the Pokemon Dream Radar" is the thing a player has to go
        // and find, and what they do once they are there is the line underneath.
        OutsideAcquisition outside => $"From {outside.SentFrom}",

        _ => "Another way",
    };

    /// <summary>
    /// The fields shown under a method, in a fixed order per kind, with anything the dataset
    /// does not know left out rather than printed empty.
    /// </summary>
    /// <remarks>
    /// One field per thing the record carries. Which fields exist is the schema's business, so
    /// a field added there shows up here by being added to one list.
    /// </remarks>
    private IReadOnlyList<(string Label, string Value)> FieldsOf(AcquisitionMethod method)
    {
        var fields = new List<(string Label, string? Value)>();

        switch (method)
        {
            case GiftAcquisition gift:
                fields.Add(("Where", gift.Location));
                fields.Add(("From", gift.Npc));
                fields.Add(("Level", gift.Level?.ToString(CultureInfo.InvariantCulture)));
                fields.Add(("First", gift.Requirement));
                break;

            case WildAcquisition wild:
                fields.Add(("How", AcquisitionNames.Of(wild.Method)));
                fields.Add(("Levels", wild.Levels.ToString()));
                fields.Add(("Chance", wild.RatePercent is { } rate
                    ? string.Create(CultureInfo.InvariantCulture, $"{rate:0.#}%")
                    : null));
                // Scarlet and Violet count in weights rather than percentages, and the label
                // says so: a weight is only comparable to the others at the same spawn point,
                // so calling it a chance would invite reading it as one.
                fields.Add(("Weight", wild.ProbabilityWeight?.ToString(CultureInfo.InvariantCulture)));
                fields.Add(("Time", wild.TimeOfDay));
                fields.Add(("Season", wild.Season));
                fields.Add(("Weather", wild.Weather));
                fields.Add(("Needs", wild.Requirement));
                break;

            case EvolutionAcquisition evolution:
                fields.Add(("How", Dataset.Reference.FindEvolutionRule(evolution.Rule) is { } rule
                    ? EvolutionNames.Describe(rule, SpeciesName)
                    : null));
                break;

            case BreedingAcquisition breeding:
                // No parents here: the title already names them, and there they are links.
                fields.Add(("Where", breeding.Location));
                fields.Add(("First", breeding.Requirement));
                break;

            case TradeAcquisition trade:
                fields.Add(("Where", trade.Location));
                fields.Add(("With", trade.Npc));
                fields.Add(("First", trade.Requirement));
                break;

            case FormChangeAcquisition change:
                fields.Add(("How", change.Requirement));
                fields.Add(("Where", change.Location));
                break;

            case OutsideAcquisition outside:
                fields.Add(("How", outside.How));
                fields.Add(("First", outside.Requirement));
                break;

            default:
                break;
        }

        // Last, and on every kind: a way that is real and does not count as being able to get
        // one here. The row is shown because the game has it; the line says why the filter
        // beside the grid will not offer it.
        fields.Add(("But", method.DoesNotCount));

        return
        [
            .. fields
                .Where(field => !string.IsNullOrWhiteSpace(field.Value))
                .Select(field => (field.Label, field.Value!)),
        ];
    }

    private string SpeciesName(SpeciesId species) => Dataset.Reference.NameOf(DexTarget.ForSpecies(species));


    /// <summary>
    /// How to get one entry from the game it was caught in into the main game.
    /// </summary>
    /// <remarks>
    /// Cached per game and entry for as long as the popup is open. The answer cannot change
    /// while it is, and several slots in one game would otherwise each pay for the same search.
    /// </remarks>
    private TransferRouteResult RouteFor(GameId from, DexTarget target)
    {
        if (_routes.TryGetValue((from, target), out var known))
        {
            return known;
        }

        var found = Transfers.RoutesBetween(from, _collection!.MainGame, target);
        _routes[(from, target)] = found;
        return found;
    }

    /// <summary>
    /// Whether the dataset knows anything at all about obtaining things in the main game. With
    /// no data the filter would answer "nothing is available here", which is a lie rather than
    /// an empty result, so the switch is offered disabled and says why.
    /// </summary>
    private bool CanAskAvailability(GameId game) => Dataset.Reference.HasAcquisitionData(game);

    private string AvailabilityHint(GameId game) => CanAskAvailability(game)
        ? $"Entries {GameName(game)} has a known way to obtain"
        : $"The dataset has no encounter data for {GameName(game)} yet.";

    /// <summary>
    /// Ticks or unticks one game. The order follows the collection rather than the clicks, so
    /// the list reads the same however the player got there.
    /// </summary>
    private void ToggleAvailability(GameId game, bool wanted)
    {
        var chosen = new HashSet<GameId>(_filter.AvailableIn);

        if (wanted)
        {
            chosen.Add(game);
        }
        else
        {
            chosen.Remove(game);
        }

        Narrow(f => f with { AvailableIn = [.. GamesOfCollection().Where(chosen.Contains)] });
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? string.Empty;
        Narrow(filter => filter with { Search = _search });
    }

    private void ClearFilters()
    {
        _search = string.Empty;
        Narrow(_ => DexFilter.None);
    }

    private void Narrow(Func<DexFilter, DexFilter> change)
    {
        _filter = change(_filter);
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        _shown = _filter.Apply(_lines, _captures, IsAvailableIn, ReachableHere);
        Chunk();
        _unreachable = _lines.Count(line => !ReachableHere(line.Target));

        // "Written to ..." was about a set of rows that is no longer the set on screen.
        _exported = null;

        // The cursor points into a list that has just changed under it. Keeping the position
        // rather than the entry is deliberate: filtering is how a player narrows down to what
        // they are working on, and landing at the top of the new list is what they expect.
        _cursor = _shown.Count == 0 ? -1 : Math.Clamp(_cursor, 0, _shown.Count - 1);

        // The grid element is removed when nothing passes the filters, so its key handling has
        // to be hooked again when it comes back.
        if (_shown.Count == 0)
        {
            _gridKeysHooked = false;
        }
    }

    /// <summary>
    /// Whether a game has a way to produce an entry that the player could actually follow.
    /// </summary>
    /// <remarks>
    /// Goes through <see cref="Availability"/> rather than asking whether any method exists,
    /// because an evolution is not a way to get something when the thing it evolves from cannot
    /// be had. Platinum evolves Ivysaur and cannot produce a Bulbasaur, and the filter used to
    /// offer the Ivysaur anyway.
    /// </remarks>
    private bool IsAvailableIn(GameId game, DexTarget target) => _availability.In(game, target);

    /// <summary>
    /// Whether anything this collection covers can produce an entry.
    /// </summary>
    /// <remarks>
    /// The same question as the "Available in" switches, asked of every game at once, so the
    /// figure above the grid and the filters beside it can never disagree about one entry.
    /// <see cref="Availability"/> remembers its answers and is rebuilt whenever the records
    /// change, which is what makes this cheap enough to ask per tile - and what makes the number
    /// fall when a transfer puts an evolution within reach.
    /// </remarks>
    private bool ReachableHere(DexTarget target) =>
        GamesOfCollection().Any(game => _availability.In(game, target));

    /// <summary>
    /// What is left that no amount of playing will produce, said in one sentence.
    /// </summary>
    /// <remarks>
    /// "In your games" once there is more than one, because the answer is about the collection
    /// rather than about the main game: a Zangoose is out of reach in Sapphire and in reach the
    /// moment Ruby is linked.
    /// </remarks>
    private string UnreachableSentence
    {
        get
        {
            var where = _collection!.LinkedGames.Count == 0
                ? GameName(_collection.MainGame)
                : "your games";
            var hidden = _filter.HideUnreachable ? ", and hidden below" : string.Empty;

            return _progress.Unreachable == 1
                ? $"One of these is out of reach in {where}{hidden}."
                : $"{_progress.Unreachable} of these are out of reach in {where}{hidden}.";
        }
    }

    /// <summary>
    /// The one-click move from the grid: catch it, or having transferred it, or take it back.
    /// </summary>
    /// <remarks>
    /// Deliberately not a cycle through the three states. From the grid the useful step is
    /// always "it is in the main game now" - either because you caught it there or because you
    /// moved it - and the way back. Choosing a linked game is a decision, and decisions belong
    /// in the popup.
    /// </remarks>
    private async Task QuickToggle(DexLine line)
    {
        var status = _captures.StatusOf(line.Target);

        await SetStatus(
            line,
            status == CaptureStatus.InMainGame ? CaptureStatus.NotCaught : CaptureStatus.InMainGame);
    }

    private string ToggleHint(CaptureStatus status) => status switch
    {
        CaptureStatus.InMainGame => "Mark as not caught",
        CaptureStatus.CaughtElsewhere => $"Mark as moved to {GameName(_collection!.MainGame)}",
        _ => $"Mark as caught in {GameName(_collection!.MainGame)}",
    };

    private static string TileClass(CaptureStatus status) => status switch
    {
        CaptureStatus.InMainGame => "is-done",
        CaptureStatus.CaughtElsewhere => "is-elsewhere",
        _ => "is-missing",
    };

    /// <summary>
    /// What the state means in words, for the tooltip and for anything that cannot see colour
    /// at all. The wording itself is in Core, so the detail popup and the filters say the same.
    /// </summary>
    private string StatusLabel(DexLine line, CaptureStatus status) => CaptureStatusNames.Of(
        status,
        GameName(_collection!.MainGame),
        _captures.RecordFor(line.Target)?.HoldingGame is { } holding ? GameName(holding) : null);

    /// <summary>The short version name, falling back to the id if the dataset has no such game.</summary>
    private string GameName(GameId game) => Dataset.Reference.FindGame(game)?.Version ?? game.Value;

    /// <summary>
    /// One segment of the bar, as a CSS width. Invariant on purpose: a Dutch Windows would
    /// otherwise write "2,4%", which is not a length and silently does nothing.
    /// </summary>
    private string BarWidth(int part) => _progress.Total == 0
        ? "0"
        : string.Create(CultureInfo.InvariantCulture, $"{part * 100.0 / _progress.Total:0.###}%");
}
