<Window x:Class="LivingDex.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:components="clr-namespace:LivingDex.Desktop.Components"
        xmlns:local="clr-namespace:LivingDex.Desktop"
        Title="Living Dex Tracker" WindowState="Maximized"
        Height="800" Width="1280"
        MinHeight="600" MinWidth="900">
    <Grid>
        <local:LivingDexWebView HostPage="wwwroot\index.html"
                              Services="{DynamicResource services}">
            <local:LivingDexWebView.RootComponents>
                <blazor:RootComponent Selector="#app"
                                      ComponentType="{x:Type components:Routes}" />
            </local:LivingDexWebView.RootComponents>
        </local:LivingDexWebView>
    </Grid>
</Window>
